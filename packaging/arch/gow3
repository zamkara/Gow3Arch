#!/usr/bin/env bash
set -euo pipefail
export SPARTAN_DATA_DIR=${SPARTAN_DATA_DIR:-${GOW3_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/gow3}}
export SPARTAN_PREBUILT=1
export PYTHONDONTWRITEBYTECODE=1
export SPARTAN_NATIVE_LAUNCHER=/usr/bin/gow3
export PYTHONPATH="/usr/lib/gow3/python${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p -- "$SPARTAN_DATA_DIR"
cd /usr/lib/gow3
exec /usr/bin/python /usr/lib/gow3/launcher/spartanport_launcher_win.py "$@"
